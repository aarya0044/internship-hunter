# --- OpenAI (scoring + resume matching + draft generation) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# --- Telegram notifications ---
# Create a bot: message @BotFather on Telegram -> /newbot -> copy the token
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Get your chat id: message @userinfobot on Telegram, it replies with your id
TELEGRAM_CHAT_ID=123456789

# --- Resume ---
# Path to your resume (PDF or .txt), used for AI matching + draft generation
RESUME_PATH=./resume.pdf

# --- Scoring ---
# Jobs scoring >= this are sent instantly. Jobs below it go into the daily digest.
SCORE_THRESHOLD=70

# --- Scheduling ---
POLL_INTERVAL_MINUTES=10
DAILY_DIGEST_HOUR_UTC=14

# --- Database ---
DATABASE_PATH=./internship_hunter.db

# --- Redis Message Broker ---
REDIS_URL=redis://127.0.0.1:6379/0
